{
	"schemaVersion": 1,
	"id": "entitycounter",
	"version": "${version}",
	"name": "Entity Counter",
	"description": "Press a hotkey (default: F7) to see how many entities of each type are standing in the block you are looking at.",
	"authors": [
		"kclucas"
	],
	"contact": {
		"sources": "https://github.com/KCLucas/entity-counter"
	},
	"license": "MIT",
	"icon": "assets/entitycounter/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.kclucas.entitycounter.client.EntityCounterClient"
		],
		"modmenu": [
			"com.kclucas.entitycounter.client.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
